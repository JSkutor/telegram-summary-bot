# ===================================================
# 텔레그램 AI 요약 봇 설정
# ===================================================

telegram:
  # my.telegram.org 에서 발급
  # ${...} 값은 .env 또는 셸 환경변수에서 읽습니다.
  api_id: "${TELEGRAM_API_ID}"
  api_secret: "${TELEGRAM_API_SECRET}"
  # 세션 파일 저장 경로 (처음 실행 시 인증 필요)
  session_name: "tg_summary_session"

  # 수집할 채널 목록 (채널 username 또는 invite link)
  channels:
    # - "@channel_username_1"
    # - "@channel_username_2"
    # - "https://t.me/some_private_channel"

  # 가져올 기간 (일 단위 - launchd 주기와 맞출 것)
  # 첫 실행 또는 상태 파일이 없을 때만 이 기간을 사용합니다.
  fetch_days: 3

runtime:
  # 실제 요약 생성 간격입니다. launchd는 더 자주 깨워서 실패 시 재시도합니다.
  digest_interval_hours: 72
  # 비워두면 config.yaml 옆에 config.state.json / config.lock 파일을 만듭니다.
  state_file: ""
  lock_file: ""
  # 마지막 성공 시각보다 조금 앞에서 다시 가져와 누락을 방지합니다.
  state_overlap_minutes: 360
  # false이면 채널 하나라도 실패했을 때 성공 상태로 기록하지 않습니다.
  allow_partial_channel_failures: false

gemini:
  api_key: "${GEMINI_API_KEY}"
  model: "gemini-2.5-flash"
  max_retries: 5
  retry_initial_seconds: 60
  retry_max_seconds: 900

  # 요약 프롬프트 (채널 성격에 맞게 수정)
  prompt_template: |
    아래 제공된 {days}일간의 뉴스 및 정보 데이터를 가장 간결한 마크다운 형식으로 요약하세요. 
    불필요한 서론이나 부연 설명은 완벽히 생략하고, 핵심 내용만 아래 구조에 맞게 작성하세요.

    # 주요 브리핑 ({date_from} ~ {date_to})

    ## 1. 핵심 요약
    - [전체 내용 중 가장 중요한 이슈 및 흐름 2~3줄 요약]

    ## 2. 출처별 주요 내용
    - **[출처명/채널명]**: [1~2줄 핵심 요약]
    - **[출처명/채널명]**: [1~2줄 핵심 요약]

    ## 3. 핵심 키워드 및 주요 동향
    - **주요 키워드**: [이슈가 된 핵심 키워드 나열]
    - **핵심 동향/지표**: [주목할 만한 트렌드, 수치, 또는 사건 1~2줄 요약]

    ---
    {messages}

output:
  # iCloud Obsidian vault 경로
  # macOS 기본 경로: ~/Library/Mobile Documents/iCloud~md~obsidian/Documents/{vault_name}
  obsidian_vault_path: "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/{vault_name}"
  # vault 안의 저장 폴더
  target_folder: "Briefings"
  # 파일명 형식 (Python strftime 포맷)
  filename_format: "briefing_%Y-%m-%d.md"

logging:
  level: "INFO"
  # 로그 파일 경로 (launchd에서 stderr 리다이렉트와 별개로 앱 레벨 로그)
  file: "~/Library/Logs/tg_summary_bot.log"
