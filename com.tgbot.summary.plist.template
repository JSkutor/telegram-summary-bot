<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tgbot.summary</string>

  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/YOUR/PROJECT/venv/bin/python3</string>
    <string>/PATH/TO/YOUR/PROJECT/main.py</string>
    <string>--config</string>
    <string>/PATH/TO/YOUR/PROJECT/config.yaml</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/PATH/TO/YOUR/PROJECT</string>

  <key>StartInterval</key>
  <integer>21600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/tgbot_stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/tgbot_stderr.log</string>
</dict>
</plist>
